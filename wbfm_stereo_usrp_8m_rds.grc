    {
      "name": "setup_note",
      "id": "note",
      "parameters": {
        "note": "Ubuntu / GNU Radio 3.10\nOpen from the directory containing stereo_test_48k.wav, or set wav_path.\nSet device_args for your USRP and verify antenna, actual rate and bandwidth.\nMonitor MPX peaks; keep |MPX| <= 1 with headroom.\n109.4 MHz is in an aeronautical navigation band: use a cabled/shielded test setup.\nRDS PS and RadioText: TX Test; PI 0x1234 is a bench-test identifier.\nNo gr-rds package required. RDS bits and CRC are embedded in Vector Source.\nShared 19 kHz oscillator generates coherent 38/57 kHz subcarriers."
      },
      "states": {
        "bus_sink": false,
        "bus_source": false,
        "bus_structure": null,
        "coordinate": [
          16,
          1520
        ],
        "rotation": 0,
        "state": "enabled"
      }
    },
