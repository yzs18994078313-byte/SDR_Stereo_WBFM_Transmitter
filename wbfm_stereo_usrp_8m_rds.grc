      "states": {
        "bus_sink": false,
        "bus_source": false,
        "bus_structure": null,
        "coordinate": [
          1760,
          16
        ],
        "rotation": 0,
        "state": "enabled"
      }
    },
    {
      "name": "rds_level",
      "id": "variable",
      "parameters": {
